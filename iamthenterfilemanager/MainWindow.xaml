<Window x:Class="MyFileManger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My File Manager"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        Background="#050108"
        Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <FontFamily x:Key="AndyFont">
            pack://application:,,,/Fonts/ANDYB.ttf#Andy
        </FontFamily>

        <Style x:Key="DarkButton"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="#141018"/>

            <Setter Property="Foreground"
                    Value="#F5EDF5"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="10"/>

            <Setter Property="Margin"
                    Value="2"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontFamily"
                    Value="{StaticResource AndyFont}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#302034"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#4A2850"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.3"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SideButton"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#DED5E0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="12,10"/>

            <Setter Property="Margin"
                    Value="2"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontFamily"
                    Value="{StaticResource AndyFont}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#25162A"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="FileItemStyle"
               TargetType="{x:Type ListViewItem}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#F0E8F2"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="8"/>

            <Setter Property="Margin"
                    Value="0,1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="FontFamily"
                    Value="{StaticResource AndyFont}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#211524"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#38203E"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style TargetType="{x:Type GridViewColumnHeader}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#968B9A"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="8,5"/>

            <Setter Property="FontFamily"
                    Value="{StaticResource AndyFont}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">

                        <Border Background="Transparent">

                            <ContentPresenter
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style TargetType="{x:Type TextBox}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#F0E8F2"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CaretBrush"
                    Value="White"/>

            <Setter Property="FontFamily"
                    Value="{StaticResource AndyFont}"/>

        </Style>

        <Style TargetType="{x:Type ScrollBar}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#5D3561"/>

            <Setter Property="Width"
                    Value="7"/>

        </Style>

    </Window.Resources>

    <Grid>

        <Canvas x:Name="SpaceCanvas"
                Panel.ZIndex="0"
                Background="Transparent"
                IsHitTestVisible="False"/>

        <Grid Panel.ZIndex="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#E0050308"
                    BorderBrush="#302332"
                    BorderThickness="0,0,0,1">

                <Grid Margin="12,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Style="{StaticResource DarkButton}"
                            Content="←"
                            Click="BackButton_Click"/>

                    <Button x:Name="ForwardButton"
                            Grid.Column="1"
                            Style="{StaticResource DarkButton}"
                            Content="→"
                            Click="ForwardButton_Click"/>

                    <Button x:Name="UpButton"
                            Grid.Column="2"
                            Style="{StaticResource DarkButton}"
                            Content="↑"
                            Click="UpButton_Click"/>

                    <Border Grid.Column="4"
                            Margin="8,0"
                            Height="38"
                            Background="#121017"
                            BorderBrush="#29202D"
                            BorderThickness="1"
                            CornerRadius="8">

                        <TextBox x:Name="PathBox"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 KeyDown="PathBox_KeyDown"/>

                    </Border>

                    <Button Grid.Column="5"
                            Style="{StaticResource DarkButton}"
                            Content="⟳"
                            Click="RefreshButton_Click"/>

                </Grid>

            </Border>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#C907050A"
                        BorderBrush="#29202D"
                        BorderThickness="0,0,1,0">

                    <StackPanel Margin="12,20">

                        <TextBlock Text="MY FILE MANAGER"
                                   FontFamily="{StaticResource AndyFont}"
                                   Foreground="#E98BE3"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="12,0,0,14"/>

                        <Button Style="{StaticResource SideButton}"
                                Content="🏠   Home"
                                Click="HomeButton_Click"/>

                        <Button Style="{StaticResource SideButton}"
                                Content="📁   Desktop"
                                Click="DesktopButton_Click"/>

                        <Button Style="{StaticResource SideButton}"
                                Content="📄   Documents"
                                Click="DocumentsButton_Click"/>

                        <Button Style="{StaticResource SideButton}"
                                Content="⬇   Downloads"
                                Click="DownloadsButton_Click"/>

                        <Button Style="{StaticResource SideButton}"
                                Content="🖼   Pictures"
                                Click="PicturesButton_Click"/>

                        <Button Style="{StaticResource SideButton}"
                                Content="🎬   Videos"
                                Click="VideosButton_Click"/>

                        <Border Height="1"
                                Background="#302332"
                                Margin="10,14"/>

                        <Button Style="{StaticResource SideButton}"
                                Content="💻   This PC"
                                Click="ThisPCButton_Click"/>

                    </StackPanel>

                </Border>

                <Grid Grid.Column="1"
                      Margin="28">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Files"
                               FontFamily="{StaticResource AndyFont}"
                               FontSize="28"
                               Foreground="#F4EDF5"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1"
                               Text="Folders and files"
                               FontFamily="{StaticResource AndyFont}"
                               FontSize="13"
                               Foreground="#968B9A"
                               VerticalAlignment="Center"/>

                    <ListView x:Name="FileList"
                              Grid.Row="2"
                              Margin="0,10,0,0"
                              Background="Transparent"
                              BorderThickness="0"
                              BorderBrush="Transparent"
                              Foreground="#F0E8F2"
                              ItemContainerStyle="{StaticResource FileItemStyle}"
                              MouseDoubleClick="FileList_MouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListView.View>

                            <GridView>

                                <GridViewColumn Header="Name"
                                                Width="360">

                                    <GridViewColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock Text="{Binding Icon}"
                                                           Width="34"
                                                           FontSize="16"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource AndyFont}"
                                                           Foreground="#F0E8F2"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </GridViewColumn.CellTemplate>

                                </GridViewColumn>

                                <GridViewColumn Header="Type"
                                                Width="130">

                                    <GridViewColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding Type}"
                                                       FontFamily="{StaticResource AndyFont}"
                                                       Foreground="#C8BFCB"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </GridViewColumn.CellTemplate>

                                </GridViewColumn>

                                <GridViewColumn Header="Size"
                                                Width="100">

                                    <GridViewColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding Size}"
                                                       FontFamily="{StaticResource AndyFont}"
                                                       Foreground="#C8BFCB"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </GridViewColumn.CellTemplate>

                                </GridViewColumn>

                                <GridViewColumn Header="Last Modified"
                                                Width="190">

                                    <GridViewColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding Modified}"
                                                       FontFamily="{StaticResource AndyFont}"
                                                       Foreground="#C8BFCB"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </GridViewColumn.CellTemplate>

                                </GridViewColumn>

                            </GridView>

                        </ListView.View>

                    </ListView>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>